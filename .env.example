# OpenRouter is the default provider. Copy this file to .env and add your own key.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4.1-mini

# Alternatively: LLM_PROVIDER=openai and LLM_MODEL=gpt-4.1-mini.
OPENAI_API_KEY=

# Optional direct-provider price estimate, in USD per million tokens.
# OpenRouter's reported usage.cost takes precedence over any estimate.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_CACHED_INPUT_USD_PER_MILLION=
LLM_PRICE_SOURCE=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1800
